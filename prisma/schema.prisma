generator client {
  provider = "prisma-client-js"
  output   = "../lib/gerado/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  admin
  gerente
  atendente
}

enum Necessidade {
  aluguel
  terno_sob_medida
  camisa_sob_medida
  ajuste
}

enum Ocasiao {
  casamento
  formatura
  corporativo
  aniversario
  outro
}

enum Etapa {
  novo
  atendimento_inicial
  agendado
  decidindo
  aguardando_retirada
  em_provas
  em_locacao
  finalizado
  perdido
}

enum Canal {
  whatsapp
  instagram
  telefone
}

enum OrigemLead {
  google_ads
  instagram
  facebook
  indicacao
  passou_na_loja
  site
  outro
}

enum MotivoPerda {
  preco
  estoque
  prazo
  concorrencia
  sem_retorno
}

enum StatusConversa {
  aberta
  resolvida
}

enum DirecaoMensagem {
  recebida
  enviada
}

enum AutorMensagem {
  cliente
  atendente
  sistema
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(atendente)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  atendimentos Atendimento[]
  tarefas      Tarefa[]
  conversas    Conversa[]
  mensagens    Mensagem[]
}

// Linha unica, com id fixo "unica". Guardar como tabela em vez de arquivo
// permite trocar o nome e a cor pelo painel, sem novo deploy.
model Configuracao {
  id       String @id @default("unica")
  nomeLoja String @default("Browns Alfaiataria")
  // Paleta oficial da Browns: marrom e creme. O creme e um campo proprio porque
  // clarear o marrom por calculo da um cinza morno, nao o creme da marca.
  corMarca String @default("#4d322e")
  corSuave String @default("#fae9db")
  logoUrl  String? @default("/marca/logo.svg")

  atualizadoEm DateTime @updatedAt
}

model Integracao {
  // "whatsapp" ou "bling"
  id           String   @id
  ativa        Boolean  @default(false)
  // Credenciais criptografadas com AES-256-GCM antes de chegar aqui. Um dump do
  // banco vazado nao entrega o token do WhatsApp de quem o roubou.
  dados        Json     @default("{}")
  atualizadoEm DateTime @updatedAt
}

enum FonteMetrica {
  ga4
  google_ads
  gsc
}

// Formato comprido, uma linha por metrica e por dia. Cada fonte tem metricas
// diferentes, e colunas fixas obrigariam migracao a cada metrica nova.
model MetricaDiaria {
  id      BigInt       @id @default(autoincrement())
  fonte   FonteMetrica
  data    DateTime     @db.Date
  metrica String
  valor   Decimal      @db.Decimal(16, 4)

  @@unique([fonte, data, metrica])
  @@index([fonte, data])
}

// Termos de busca do Search Console. Ficam separados das metricas diarias
// porque sao muitos por dia e tem dimensoes proprias.
model TermoBusca {
  id         BigInt   @id @default(autoincrement())
  // "query" ou "page"
  dimensao   String
  data       DateTime @db.Date
  termo      String   @db.VarChar(600)
  cliques    Int      @default(0)
  impressoes Int      @default(0)
  posicao    Decimal  @db.Decimal(7, 2)

  @@unique([dimensao, data, termo])
  @@index([dimensao, data])
}

model SincronizacaoMarketing {
  id         String    @id @default("unica")
  rodadaEm   DateTime?
  resultado  String?
  comErro    Boolean   @default(false)
}

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  // Sempre em E.164 (5511999999999). Unico para o webhook do WhatsApp
  // conseguir achar o cliente pelo numero sem criar duplicata.
  telefone    String   @unique
  email       String?
  observacoes String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  atendimentos Atendimento[]
  conversas    Conversa[]

  @@index([nome])
}

model Atendimento {
  id               String       @id @default(cuid())
  cliente          Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId        String
  origem           OrigemLead
  canal            Canal
  necessidade      Necessidade
  ocasiao          Ocasiao?
  dataEvento       DateTime?
  interesseInicial String?
  etapa            Etapa        @default(novo)
  valor            Decimal?     @db.Decimal(10, 2)
  responsavel      Usuario?     @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId    String?
  motivoPerda      MotivoPerda?
  // Checklist da etapa. Os campos variam por etapa, entao ficam em JSON em vez
  // de virar dezenas de colunas quase sempre nulas. A definicao de quais campos
  // existem vive em lib/funil.ts.
  dados            Json         @default("{}")
  criadoEm         DateTime     @default(now())
  atualizadoEm     DateTime     @updatedAt

  tarefas Tarefa[]

  @@index([etapa])
  @@index([dataEvento])
  @@index([origem])
}

model Tarefa {
  id            String      @id @default(cuid())
  atendimento   Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  atendimentoId String
  titulo        String
  etapaOrigem   Etapa
  venceEm       DateTime
  concluida     Boolean     @default(false)
  concluidaEm   DateTime?
  responsavel   Usuario?    @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId String?
  criadoEm      DateTime    @default(now())

  @@index([venceEm, concluida])
}

model Conversa {
  id               String         @id @default(cuid())
  cliente          Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId        String
  canal            Canal
  status           StatusConversa @default(aberta)
  naoLidas         Int            @default(0)
  ultimaMensagem   String?
  ultimaMensagemEm DateTime?
  responsavel      Usuario?       @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId    String?
  criadoEm         DateTime       @default(now())

  mensagens Mensagem[]

  @@index([status, ultimaMensagemEm])
}

model Mensagem {
  id            String          @id @default(cuid())
  conversa      Conversa        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId    String
  direcao       DirecaoMensagem
  autor         AutorMensagem
  conteudo      String
  // Id da mensagem na Meta. Unico para o webhook nao gravar duplicata quando
  // a Meta reenvia o mesmo evento, o que acontece com frequencia.
  idExterno     String?         @unique
  enviadaPor    Usuario?        @relation(fields: [enviadaPorId], references: [id], onDelete: SetNull)
  enviadaPorId  String?
  enviadaEm     DateTime        @default(now())

  @@index([conversaId, enviadaEm])
}
